# Copy these into Streamlit Cloud -> your app -> Settings -> Secrets (TOML format).
# NEVER commit the real secrets.toml to GitHub.

whatsapp_number = "91XXXXXXXXXX"   # your WhatsApp number with country code, digits only (optional)

[sheets]
spreadsheet_key = "PASTE_YOUR_GOOGLE_SHEET_KEY_HERE"

[gcp_service_account]
type = "service_account"
project_id = "PASTE"
private_key_id = "PASTE"
private_key = "-----BEGIN PRIVATE KEY-----\nPASTE\n-----END PRIVATE KEY-----\n"
client_email = "PASTE@PASTE.iam.gserviceaccount.com"
client_id = "PASTE"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "PASTE"
